# COMMON
BOT_TOKEN="..."                    # Токен бота от @BotFather
CHAT_ID="..."                      # ID чата для уведомлений
TEST_MODE=true                     # Режим тестового работы (true/false) в тестовом режиме бот не отправляет отклики

# HH URLS
HH_MAIN_URL="https://hh.ru"        # Базовый URL HH.ru
# DATABASE
DATABASE_URL="file:./dev.db"       # Путь к SQLite БД

# LLM
LLM_PROVIDER="ollama"              # Провайдер LLM (ollama/openrouter/polza)
OLLAMA_MODEL="gemma4:12b"          # Модель Ollama

# TELEGRAM
TELEGRAM_WAIT_TIMEOUT_MS=3600000   # Таймаут ожидания ответа пользователя (60 мин)